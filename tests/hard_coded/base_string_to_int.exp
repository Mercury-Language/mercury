### Empty strings ###

base_string_to_{int,uint}( 10,       "") ==> no
base_string_to_{int,uint}(  2,       "") ==> no
base_string_to_{int,uint}( 36,       "") ==> no

### Blank strings ###

base_string_to_{int,uint}( 10,      " ") ==> no
base_string_to_{int,uint}( 10,    "   ") ==> no
base_string_to_{int,uint}( 10,     "\t") ==> no
base_string_to_{int,uint}( 10,     "\n") ==> no
base_string_to_{int,uint}( 10,   " \t ") ==> no
base_string_to_{int,uint}(  2,      " ") ==> no
base_string_to_{int,uint}( 36,      " ") ==> no

### Signs ###

base_string_to_{int,uint}( 10,     "-1") ==> int =  -1, uint =  no
base_string_to_{int,uint}( 10,     "+1") ==> int =   1, uint =  no
base_string_to_{int,uint}( 10,     "-0") ==> int =   0, uint =  no
base_string_to_{int,uint}( 10,     "+0") ==> int =   0, uint =  no
base_string_to_{int,uint}( 10,      "-") ==> no
base_string_to_{int,uint}( 10,      "+") ==> no
base_string_to_{int,uint}( 16,      "-") ==> no
base_string_to_{int,uint}(  2,      "+") ==> no
base_string_to_{int,uint}( 10,     "--") ==> no
base_string_to_{int,uint}( 10,     "++") ==> no
base_string_to_{int,uint}( 10,    "+-1") ==> no
base_string_to_{int,uint}( 10,    "-+1") ==> no
base_string_to_{int,uint}( 10,     "- ") ==> no
base_string_to_{int,uint}( 10,     "+ ") ==> no

### Single digits ###

base_string_to_{int,uint}( 10,      "0") ==> 0
base_string_to_{int,uint}( 10,      "7") ==> 7
base_string_to_{int,uint}( 10,     "-7") ==> int =  -7, uint =  no
base_string_to_{int,uint}( 10,     "+7") ==> int =   7, uint =  no
base_string_to_{int,uint}(  2,      "0") ==> 0
base_string_to_{int,uint}(  2,      "1") ==> 1
base_string_to_{int,uint}(  8,      "7") ==> 7
base_string_to_{int,uint}( 16,      "f") ==> 15
base_string_to_{int,uint}( 16,      "F") ==> 15
base_string_to_{int,uint}( 36,      "z") ==> 35
base_string_to_{int,uint}( 36,      "Z") ==> 35

### Upper and lower case digits ###

base_string_to_{int,uint}( 16, "abcdef") ==> 11259375
base_string_to_{int,uint}( 16, "ABCDEF") ==> 11259375
base_string_to_{int,uint}( 16, "AbCdEf") ==> 11259375
base_string_to_{int,uint}( 16,    "-Ff") ==> int = -255, uint =  no
base_string_to_{int,uint}( 36,    "abz") ==> 13391
base_string_to_{int,uint}( 36,    "ABZ") ==> 13391
base_string_to_{int,uint}( 36,    "AbZ") ==> 13391

### Leading zeros ###

base_string_to_{int,uint}( 10,     "00") ==> 0
base_string_to_{int,uint}( 10,    "007") ==> 7
base_string_to_{int,uint}( 10,   "-007") ==> int =  -7, uint =  no
base_string_to_{int,uint}( 10,   "+007") ==> int =   7, uint =  no
base_string_to_{int,uint}(  2, "000101") ==> 5
base_string_to_{int,uint}(  8,  "00017") ==> 15
base_string_to_{int,uint}( 16,  "000ff") ==> 255
base_string_to_{int,uint}( 36,   "000z") ==> 35
base_string_to_{int,uint}( 10, "0000000000000000000000000000000") ==> 0
base_string_to_{int,uint}( 10, "0000000000000000000000000000001") ==> 1

### Digits not valid in the specified base ###

base_string_to_{int,uint}(  2,      "1") ==> 1
base_string_to_{int,uint}(  2,      "2") ==> no
base_string_to_{int,uint}(  3,      "2") ==> 2
base_string_to_{int,uint}(  3,      "3") ==> no
base_string_to_{int,uint}(  8,      "7") ==> 7
base_string_to_{int,uint}(  8,      "8") ==> no
base_string_to_{int,uint}(  9,      "8") ==> 8
base_string_to_{int,uint}(  9,      "9") ==> no
base_string_to_{int,uint}( 10,      "9") ==> 9
base_string_to_{int,uint}( 10,      "a") ==> no
base_string_to_{int,uint}( 10,      "A") ==> no
base_string_to_{int,uint}( 11,      "a") ==> 10
base_string_to_{int,uint}( 11,      "A") ==> 10
base_string_to_{int,uint}( 11,      "b") ==> no
base_string_to_{int,uint}( 11,      "B") ==> no
base_string_to_{int,uint}( 16,      "f") ==> 15
base_string_to_{int,uint}( 16,      "g") ==> no
base_string_to_{int,uint}( 16,      "G") ==> no
base_string_to_{int,uint}( 17,      "g") ==> 16
base_string_to_{int,uint}( 17,      "h") ==> no
base_string_to_{int,uint}( 35,      "y") ==> 34
base_string_to_{int,uint}( 35,      "z") ==> no
base_string_to_{int,uint}( 35,      "Z") ==> no
base_string_to_{int,uint}( 36,      "z") ==> 35
base_string_to_{int,uint}( 36,      "Z") ==> 35
base_string_to_{int,uint}(  2,    "102") ==> no
base_string_to_{int,uint}(  8,    "178") ==> no
base_string_to_{int,uint}( 16,    "1fg") ==> no

### Non-digit characters ###

base_string_to_{int,uint}( 10,     " 1") ==> no
base_string_to_{int,uint}( 10,     "1 ") ==> no
base_string_to_{int,uint}( 10,    "1 2") ==> no
base_string_to_{int,uint}( 10,    "1.0") ==> no
base_string_to_{int,uint}( 10,  "1,000") ==> no
base_string_to_{int,uint}( 10,  "1_000") ==> no
base_string_to_{int,uint}( 10,    "1e5") ==> no
base_string_to_{int,uint}( 16,   "0x10") ==> no
base_string_to_{int,uint}( 10,    "\t1") ==> no
base_string_to_{int,uint}( 10,    "1\n") ==> no
base_string_to_{int,uint}( 36,     "1!") ==> no
base_string_to_{int,uint}( 10,      "３") ==> no

### Signs in the wrong place ###

base_string_to_{int,uint}( 10,     "1-") ==> no
base_string_to_{int,uint}( 10,     "1+") ==> no
base_string_to_{int,uint}( 10,    "1-2") ==> no
base_string_to_{int,uint}( 10,  "12-34") ==> no
base_string_to_{int,uint}( 10,    "--1") ==> no
base_string_to_{int,uint}( 10,    "++1") ==> no
base_string_to_{int,uint}( 10,    "-1-") ==> no

### The string "10" in every base ###

base_string_to_{int,uint}(  2,     "10") ==> 2
base_string_to_{int,uint}(  3,     "10") ==> 3
base_string_to_{int,uint}(  4,     "10") ==> 4
base_string_to_{int,uint}(  5,     "10") ==> 5
base_string_to_{int,uint}(  6,     "10") ==> 6
base_string_to_{int,uint}(  7,     "10") ==> 7
base_string_to_{int,uint}(  8,     "10") ==> 8
base_string_to_{int,uint}(  9,     "10") ==> 9
base_string_to_{int,uint}( 10,     "10") ==> 10
base_string_to_{int,uint}( 11,     "10") ==> 11
base_string_to_{int,uint}( 12,     "10") ==> 12
base_string_to_{int,uint}( 13,     "10") ==> 13
base_string_to_{int,uint}( 14,     "10") ==> 14
base_string_to_{int,uint}( 15,     "10") ==> 15
base_string_to_{int,uint}( 16,     "10") ==> 16
base_string_to_{int,uint}( 17,     "10") ==> 17
base_string_to_{int,uint}( 18,     "10") ==> 18
base_string_to_{int,uint}( 19,     "10") ==> 19
base_string_to_{int,uint}( 20,     "10") ==> 20
base_string_to_{int,uint}( 21,     "10") ==> 21
base_string_to_{int,uint}( 22,     "10") ==> 22
base_string_to_{int,uint}( 23,     "10") ==> 23
base_string_to_{int,uint}( 24,     "10") ==> 24
base_string_to_{int,uint}( 25,     "10") ==> 25
base_string_to_{int,uint}( 26,     "10") ==> 26
base_string_to_{int,uint}( 27,     "10") ==> 27
base_string_to_{int,uint}( 28,     "10") ==> 28
base_string_to_{int,uint}( 29,     "10") ==> 29
base_string_to_{int,uint}( 30,     "10") ==> 30
base_string_to_{int,uint}( 31,     "10") ==> 31
base_string_to_{int,uint}( 32,     "10") ==> 32
base_string_to_{int,uint}( 33,     "10") ==> 33
base_string_to_{int,uint}( 34,     "10") ==> 34
base_string_to_{int,uint}( 35,     "10") ==> 35
base_string_to_{int,uint}( 36,     "10") ==> 36

### Invalid bases ###

base_string_to_{int,uint}(  1,      "1") ==> exception
base_string_to_{int,uint}(  0,      "1") ==> exception
base_string_to_{int,uint}( -1,      "1") ==> exception
base_string_to_{int,uint}( 37,      "1") ==> exception
base_string_to_{int,uint}(100,      "1") ==> exception

### det_base_string_to_{int,uint} ###

det_base_string_to_{int,uint}(10, "123") ==> 123
det_base_string_to_{int,uint}(16,  "ff") ==> 255
det_base_string_to_{int,uint}(10,    "") ==> exception
det_base_string_to_{int,uint}(10, "12a") ==> exception
det_base_string_to_{int,uint}( 1,   "1") ==> exception

### to_{int,uint} ###

to_{int,uint}( "123") ==> 123
to_{int,uint}("-123") ==> int = -123, uint =  no
to_{int,uint}(    "") ==> no
to_{int,uint}("0x10") ==> no
to_{int,uint}(  " 1") ==> no

